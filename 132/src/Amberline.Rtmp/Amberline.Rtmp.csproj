<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Amberline.Rtmp</AssemblyName>
    <RootNamespace>RtmpSharp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <!-- Batch 797: the files both patch lines share are in host/. -->
    <Compile Include="$(HostRoot)src\Amberline.Rtmp\**\*.cs" LinkBase="host" />
    <None Include="$(HostRoot)src\Amberline.Rtmp\LICENSE" CopyToOutputDirectory="PreserveNewest" TargetPath="third-party/RtmpSharp-LICENSE" />
    <None Include="$(HostRoot)src\Amberline.Rtmp\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" TargetPath="third-party/RtmpSharp-NOTICES.md" />
  </ItemGroup>
</Project>
